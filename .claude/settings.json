{
  "permissions": {
    "allow": [
      "Bash(sbatch:*)",
      "Bash(squeue:*)",
      "Bash(sacct:*)",
      "Bash(sinfo:*)",
      "Bash(scontrol show:*)",
      "Bash(ls:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(du:*)",
      "Bash(df:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(python scripts/python/aggregate_results.py:*)",
      "Bash(python scripts/python/make_report.py:*)",
      "Bash(find data:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Read(**)",
      "Bash(scripts/cscs/gpu_hours.sh:*)",
      "Bash(bash scripts/cscs/gpu_hours.sh:*)",
      "Bash(sreport:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(scancel:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/cscs/notify.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/cscs/notify.py"
          }
        ]
      }
    ]
  }
}
